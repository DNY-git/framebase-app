{
  "name": "@constructtrack/api",
  "version": "0.1.0",
  "private": true,
  "description": "ConstructTrack API — NestJS modular monolith",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/database/seed.ts",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "backup:local": "mongodump --uri=\"${MONGODB_URI:-mongodb://127.0.0.1:27017/constructtrack}\" --archive=.backups/$(date +%Y%m%d_%H%M%S).archive",
    "restore:local": "mongorestore --uri=\"${MONGODB_URI:-mongodb://127.0.0.1:27017/constructtrack}\" --archive=.backups/$(ls -t .backups/*.archive 2>/dev/null | head -1) --drop"
  },
  "dependencies": {
    "@constructtrack/types": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "mongoose": "^8.8.0",
    "nest-winston": "^1.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "^22.10.0",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^8.57.0",
    "mongodb-memory-server": "^10.1.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
