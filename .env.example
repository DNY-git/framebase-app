# =============================================================================
# ConstructTrack — Environment Variables Example
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit the real
# `.env`. Secrets must come from the environment (or a secrets manager in prod)
# — see docs/security/data-protection.md.
#
# All values below are placeholders or safe local-only defaults. Anything marked
# [REQUIRED] must be set before the app will start. Anything marked [OPTIONAL]
# has a working default shown.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=4000                        # API HTTP port
WEB_PORT=5173                    # Vite dev server port
LOG_LEVEL=debug                  # trace | debug | info | warn | error (use info in prod)

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=ConstructTrack
APP_URL=http://localhost:5173   # Public web origin (used for emails, CORS, etc.)
API_URL=http://localhost:4000   # Public API origin

# -----------------------------------------------------------------------------
# Database (MongoDB Atlas)  [OPTIONAL — app starts with graceful degradation]
# -----------------------------------------------------------------------------
# Get a free cluster at https://www.mongodb.com/atlas
# The app will start and respond to health checks even without this configured,
# but DB-dependent features will not function.
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/constructtrack?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Authentication & Security  [REQUIRED in production]
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64   (do NOT reuse across environments)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m               # short-lived access token
JWT_REFRESH_TTL=7d               # long-lived refresh token
PASSWORD_PEPPER=change-me-pepper  # extra secret mixed into password hashing
BCRYPT_ROUNDS=12                 # cost factor; 12 is a sane default

# Session / cookie
COOKIE_SECRET=change-me-cookie-secret
COOKIE_SECURE=false              # true in production (HTTPS only)

# -----------------------------------------------------------------------------
# CORS  [REQUIRED in production]
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Keep tight in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Rate Limiting  [OPTIONAL — sensible defaults below]
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_LIMIT=100           # Max requests per window for authenticated users
RATE_LIMIT_AUTH_TTL=60000           # Window duration in ms for authenticated users
RATE_LIMIT_PUBLIC_LIMIT=20          # Max requests per window for anonymous users
RATE_LIMIT_PUBLIC_TTL=60000         # Window duration in ms for anonymous users

# -----------------------------------------------------------------------------
# AI (Optional)  [OPTIONAL — app runs fully without]
# -----------------------------------------------------------------------------
# Set AI_PROVIDER=none to disable AI features (default). To enable, set to
# 'openai' or 'anthropic' and implement the corresponding adapter.
AI_PROVIDER=none
AI_MAX_TOKENS=1000                 # Max response tokens per call
AI_REQUEST_TIMEOUT_MS=15000        # Timeout for sync AI requests (ms)
